# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# C / C++ source and headers
[*.{c,h,cpp,hpp,ino}]
indent_style = space
indent_size = 4

# Python
[*.py]
indent_style = space
indent_size = 4

# CMake and build files
[{CMakeLists.txt,*.cmake,Kconfig*,*.spec}]
indent_style = space
indent_size = 4

# Markdown & Documentation
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# YAML and JSON
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
end_of_line = lf
indent_style = space
indent_size = 4

# Batch files
[*.bat]
end_of_line = crlf
indent_style = space
indent_size = 4
