CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_MAX_SOCKETS=22

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_VFS_MAX_COUNT=10

# Match simple_video_server_ap's ESP32-P4C5-CAM SDIO slave reset wiring.
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=50
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=50
CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=700
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y

# ESP32-C5 SoftAP: 5 GHz with 802.11ax enabled by network_service.c.
# CONFIG_EXAMPLE_WIFI_AP_BAND_5G_ONLY is not set
CONFIG_EXAMPLE_WIFI_AP_BAND_2G_ONLY=y
CONFIG_EXAMPLE_WIFI_AP_CHANNEL=1
# CONFIG_EXAMPLE_WIFI_AP_AUTO_CHANNEL is not set

# Keep the GC2145 MIPI-CSI capture path enabled across sdkconfig regeneration.
CONFIG_ESP_VIDEO_ENABLE_ISP=y
CONFIG_ESP_VIDEO_ENABLE_DATA_PREPROCESSING=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_DISABLE_MIPI_CSI_DRIVER_BACKUP_BUFFER=y
CONFIG_ESP_VIDEO_ENABLE_SWAP_SHORT=y
CONFIG_ESP_VIDEO_ENABLE_SWAP_SHORT_RISCV=y
CONFIG_ESP_VIDEO_ENABLE_SWAP_BYTE=y
CONFIG_ESP_VIDEO_ENABLE_SWAP_BYTE_RISCV=y

# Leave internal DMA headroom for the C5 ESP-Hosted SDIO path.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_HEAP_POISONING_DISABLED=y

CONFIG_LWIP_TCP_RTO_TIME=250

CONFIG_LWIP_TCP_SACK_OUT=y
