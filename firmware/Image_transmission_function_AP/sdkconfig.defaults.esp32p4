CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_CAMERA_SC2336=n

CONFIG_IDF_EXPERIMENTAL_FEATURES=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

CONFIG_EXAMPLE_ENABLE_CAM_SENSOR_PIC_VFLIP=y
CONFIG_EXAMPLE_ENABLE_CAM_SENSOR_PIC_HFLIP=y
CONFIG_EXAMPLE_CAMERA_VIDEO_BUFFER_NUMBER=3
CONFIG_EXAMPLE_JPEG_COMPRESSION_QUALITY=70

CONFIG_EXAMPLE_SELECT_CUSTOMIZED_DEV_BOARD=y
CONFIG_EXAMPLE_MIPI_CSI_SCCB_I2C_SCL_PIN=29
CONFIG_EXAMPLE_MIPI_CSI_SCCB_I2C_SDA_PIN=28
CONFIG_TEST_I2C_SCL_GPIO=47
CONFIG_TEST_BOOT_GPIO=35
CONFIG_TEST_I2C_SDA_GPIO=46
CONFIG_EXAMPLE_MIPI_CSI_SCCB_I2C_FREQ=100000
CONFIG_I2C_ENABLE_SLAVE_DRIVER_VERSION_2=y
CONFIG_EXAMPLE_MIPI_CSI_CAM_MOTOR_SCCB_I2C_SCL_PIN=29
CONFIG_EXAMPLE_MIPI_CSI_CAM_MOTOR_SCCB_I2C_SDA_PIN=28
CONFIG_EXAMPLE_DVP_SCCB_I2C_SCL_PIN=29
CONFIG_EXAMPLE_DVP_SCCB_I2C_SDA_PIN=28
CONFIG_EXAMPLE_SPI_CAM_0_SCCB_I2C_SCL_PIN=29
CONFIG_EXAMPLE_SPI_CAM_0_SCCB_I2C_SDA_PIN=28

CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# CONFIG_EXAMPLE_WIFI_AP_AUTO_CHANNEL is not set
CONFIG_CAMERA_GC2145_WRITE_REGS_DELAY_US=500

CONFIG_CAMERA_GC2145=y
CONFIG_CAMERA_GC2145_MIPI_RGB565_800X600_30FPS=y
CONFIG_CAMERA_GC2145_MIPI_DEFAULT_FMT_RGB565_800X600_30FPS=y

CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_HEAP_POISONING_DISABLED=y
