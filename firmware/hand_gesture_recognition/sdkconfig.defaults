# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.0 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_I2C_ENABLE_SLAVE_DRIVER_VERSION_2=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP=n
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_CAMERA_SC2336=n
CONFIG_CAMERA_GC2145=y
CONFIG_CAMERA_GC2145_MIPI_RGB565_800X600_30FPS=y
CONFIG_CAMERA_GC2145_MIPI_DEFAULT_FMT_RGB565_800X600_30FPS=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=n
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# -----------------------------------------------------------------------------
# Web backhaul over the on-module ESP32-C5 (ESP-Hosted over SDIO)
# -----------------------------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=50
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=50
CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=700
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y

CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_MAX_SOCKETS=22
CONFIG_VFS_MAX_COUNT=10

CONFIG_WHO_WEB_AP_SSID="ESP32-P4C5-CAM"
CONFIG_WHO_WEB_AP_PASSWORD=""
CONFIG_WHO_WEB_AP_BAND_5G_ONLY=y
CONFIG_WHO_WEB_AP_CHANNEL=36
CONFIG_WHO_WEB_AP_MAX_CONNECTIONS=4
CONFIG_WHO_WEB_HTTP_PORT=80
CONFIG_WHO_WEB_STREAM_PORT=81
CONFIG_WHO_WEB_JPEG_QUALITY=60
CONFIG_WHO_WEB_STREAM_FPS=10

# Keep the bootloader below the 24 KB limit at partition offset 0x8000.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_HEAP_POISONING_DISABLED=y
